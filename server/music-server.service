# systemd unit example: copy to /etc/systemd/system/music-server.service, adjust User and paths, then
#   sudo systemctl daemon-reload && sudo systemctl enable --now music-server
[Unit]
Description=Musicstreaming server (Bruce)
After=network-online.target
Wants=network-online.target

[Service]
User=music
WorkingDirectory=/opt/musicstreaming
# yt-dlp and ffmpeg must be on this PATH (a venv's bin first if yt-dlp is installed there)
Environment=PATH=/opt/musicstreaming/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=MUSIC_HOST=0.0.0.0
Environment=MUSIC_PORT=5057
Environment=MUSIC_TOKEN=change-me-to-a-long-random-string
Environment=MUSIC_LAN_ONLY=1
ExecStart=/opt/musicstreaming/venv/bin/python /opt/musicstreaming/server.py
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/musicstreaming

[Install]
WantedBy=multi-user.target
